# Copy to .env on the VDS (do not commit real secrets).
PORT=8765
BRANCH=main
COMPOSE_PROJECT_NAME=divider

# Required for the home-page "Update from git" button.
# Generate with: openssl rand -hex 24
UPDATE_TOKEN=

# Optional: SSH dir mounted into the updater for private git remotes.
# DIVIDER_SSH_DIR=/root/.ssh
